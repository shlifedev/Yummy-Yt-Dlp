{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "opener:default",
    "opener:allow-reveal-item-in-dir",
    "opener:allow-open-path",
    "clipboard-manager:allow-read-text",
    "dialog:default",
    "store:default",
    "os:default",
    "updater:default",
    "process:default"
  ]
}

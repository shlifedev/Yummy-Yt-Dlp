{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Modern YT-DLP GUI",
  "version": "0.1.0",
  "identifier": "com.modern-ytdlp-gui.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:10000",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Yummy YT-DLP",
        "width": 900,
        "height": 600,
        "minWidth": 640,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' asset: https://asset.localhost https: data:; connect-src ipc: http://ipc.localhost https://api.github.com https://github.com"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZGNzJBNUNDNDBEQ0I5MzIKUldReXVkeEF6S1Z5L3dzQ0hjWHd2MVN6TWZVV1Frb1ZDcjhVYU9PS2lpVkhiWHJkTG9PQS9GRzMK",
      "endpoints": [
        "https://patcher-server-yt-dlp.shlife.dev/yummy-yt-dlp/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "resources": {
      "binaries/*": "binaries/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
